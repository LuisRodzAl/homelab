# ============================================================
# PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# Copia este archivo a ".env" y reemplaza los valores de ejemplo
# cp env.example .env
# ============================================================

# --- Pi-hole ---
# Contraseña de acceso al panel web (http://pihole.casa o http://IP:8081/admin)
PIHOLE_PASSWORD=cambia_esta_contrasena_segura

# --- MariaDB / RomM Database ---
# Contraseña para el usuario de base de datos de RomM
ROMM_DB_PASSWORD=cambia_esta_contrasena_db
# Contraseña para el usuario root de MariaDB
ROMM_DB_ROOT_PASSWORD=cambia_esta_contrasena_root

# --- Speedtest Tracker ---
# Clave de cifrado de la aplicación Laravel de Speedtest Tracker.
# Puedes generar una con: echo "base64:$(openssl rand -base64 32)"
SPEEDTEST_APP_KEY=base64:generar_clave_base64_aqui

# --- RomM (Retro Games Manager) ---
# Clave secreta para JWT/sesiones de RomM (string aleatorio de 64 caracteres hex)
# Generar con: openssl rand -hex 32
ROMM_AUTH_SECRET_KEY=generar_clave_hex_de_64_caracteres

# API Key de RetroAchievements (opcional, para logros retro)
# Obtener en: https://retroachievements.org/controlpanel.php
RETROACHIEVEMENTS_API_KEY=tu_api_key_retroachievements

# Credenciales de Twitch / IGDB (opcional, para metadata de juegos y portadas)
# Obtener en: https://dev.twitch.tv/console/apps
IGDB_CLIENT_ID=tu_igdb_client_id
IGDB_CLIENT_SECRET=tu_igdb_client_secret
